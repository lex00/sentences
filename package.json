{
  "name": "sentences",
  "version": "0.1.0",
  "type": "module",
  "description": "Effects-rich, interactive Reed-Kellogg sentence-diagram renderer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lex00/sentences.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node src/bench/particles.bench.mjs",
    "build:lint-dist": "tsc -p tsconfig.lint-dist.json",
    "prepare": "npm run build:lint-dist"
  },
  "files": [
    "dist-lint"
  ],
  "exports": {
    "./lint/registry": {
      "types": "./dist-lint/lint/registry.d.ts",
      "default": "./dist-lint/lint/registry.js"
    },
    "./lint/engine": {
      "types": "./dist-lint/lint/engine.d.ts",
      "default": "./dist-lint/lint/engine.js"
    },
    "./lint/build-doc": {
      "types": "./dist-lint/lint/build-doc.d.ts",
      "default": "./dist-lint/lint/build-doc.js"
    },
    "./lint/report": {
      "types": "./dist-lint/lint/report.d.ts",
      "default": "./dist-lint/lint/report.js"
    },
    "./lint/markdown-prose": {
      "types": "./dist-lint/lint/markdown-prose.d.ts",
      "default": "./dist-lint/lint/markdown-prose.js"
    }
  },
  "devDependencies": {
    "@fontsource/tinos": "^5.2.7",
    "@types/opentype.js": "^1.3.10",
    "@webgpu/types": "^0.1.71",
    "onnxruntime-web": "^1.27.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "compromise": "^14.15.1"
  }
}
